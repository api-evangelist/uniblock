            "url": {
              "raw": "{{baseUrl}}/transactions?chain=<string>&address=<string>&limit=25&cursor=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "description": "(Required) The blockchain network identifier (e.g., ethereum, polygon, solana, bsc, arbitrum, optimism, avalanche, base).",
                  "key": "chain",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The wallet address to query data for.",
                  "key": "address",
                  "value": "<string>"
                },
                {
                  "description": "Maximum number of results to return per page.",
                  "key": "limit",
                  "value": "25"
                },
                {
                  "description": "Pagination cursor for retrieving the next page of results.",
                  "key": "cursor",
                  "value": "<string>"
                }
              ]
            },
            "description": "Retrieves a list of transactions associated with a specific wallet address, including both incoming and outgoing transactions across the specified blockchain network."
