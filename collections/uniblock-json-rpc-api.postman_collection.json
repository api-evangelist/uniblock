                  "name": "Send a JSON-RPC Request",
                  "id": "3762a692-6808-44ce-b766-34f8e867c02b",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"<integer>\",\n  \"method\": \"<string>\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/json-rpc/v1/:chain",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "json-rpc",
                        "v1",
                        ":chain"
                      ],
                      "variable": [
                        {
                          "id": "59be6ca8-18be-4616-870c-bd029357664b",
                          "key": "chain",
                          "value": "<string>",
                          "description": "(Required) The blockchain network to send the JSON-RPC request to (e.g., ethereum, polygon, solana, bsc, arbitrum, optimism, avalanche, base)."
                        }
                      ]
                    },
                    "description": "Sends a standard JSON-RPC 2.0 request to the specified blockchain network. Uniblock automatically routes the request to the best available upstream node provider based on reliability, cost, and performance. Supports standard Ethereum methods like eth_blockNumber, eth_getBalance, eth_call, eth_sendRawTransaction, eth_getTransactionByHash, eth_getLogs, and others, as well as Solana and chain-specific methods."
                  },
